{
  "name": "@figma-reader/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./workspace": "./dist/application/workspace.js",
    "./loader": "./dist/adapters/out/openfig-loader.js",
    "./fig-loader": "./dist/adapters/out/openfig-loader.js",
    "./mcp": "./dist/adapters/in/mcp.js",
    "./theme-data": "./dist/application/theme-data.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/application/*.test.ts src/adapters/in/*.test.ts"
  },
  "dependencies": {
    "@figma-reader/fig-engine": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.0.0",
    "@fastify/multipart": "^9.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0"
  }
}
